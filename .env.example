# ─────────────────────────────────────────────────────────────────────────
# Variables de entorno de seguimiento-habitos-app — ARCHIVO DE EJEMPLO.
#
# Copia este archivo a `.env` y pon ahí tus valores reales.
# `.env` está en .gitignore y NUNCA se sube al repositorio.
#
# Este archivo sí se versiona, pero solo con valores de ejemplo: sirve para
# que quien clone el proyecto sepa qué variables necesita, sin darle ninguna
# credencial.
# ─────────────────────────────────────────────────────────────────────────

# Clave del proveedor de IA (Google AI Studio → https://aistudio.google.com/apikey).
# La usa ÚNICAMENTE el proxy de `mock-server/`. La app nunca la ve.
# Si se deja vacía, el proxy arranca en modo REGLAS y la app funciona igual.
GEMINI_API_KEY=

# Modelo a usar. Opcional.
GEMINI_MODEL=gemini-2.5-flash

# Puerto del proxy. Opcional.
PORT=3000

# ─────────────────────────────────────────────────────────────────────────
# Las direcciones del backend y del proxy NO se leen de aquí: se pasan al
# compilar la app, para que la misma compilación sirva en distintos entornos.
#
#   flutter run \
#     --dart-define=API_BASE_URL=http://10.0.2.2:8000 \
#     --dart-define=LLM_BACKEND_URL=http://10.0.2.2:3000
# ─────────────────────────────────────────────────────────────────────────
